#!/usr/bin/env bash
# me – универсальный инструмент оперативного управления системой
# Отказоустойчивый движок с ленивой загрузкой методов

CONF_DIR="$HOME/.config/me"
CONF_FILE="$CONF_DIR/me.conf"

CACHE_DIR="$HOME/.cache/me"
CACHE_FILE="$CACHE_DIR/me.cache"
HASH_FILE="$CACHE_DIR/me.hash"

ME_LOGO_FILE="$CONF_DIR/.logo"
ME_LOGO_ENABLED=0
[ -f "$ME_LOGO_FILE" ] && [ "$(cat "$ME_LOGO_FILE")" = "1" ] && ME_LOGO_ENABLED=1

show_logo() {
    [ "$ME_LOGO_ENABLED" -eq 0 ] && return
    printf '\033[1;32m\\me/\033[0m\n'
}

if [ ! -f "$CONF_FILE" ]; then
    mkdir -p "$CONF_DIR"
    touch "$CONF_FILE"
    echo "[me] Создан пустой конфиг: $CONF_FILE." >&2
fi

# Загрузка вспомогательных функций из конфига (без префикса me_method_)
load_helpers() {
    local body
    body=$(awk '
        /^[a-zA-Z_][a-zA-Z0-9_]*\(\)/ && !/^me_method_/ { flag=1; print; next }
        flag && /^}/ { print; flag=0; next }
        flag { print }
    ' "$CONF_FILE")
    [ -n "$body" ] && eval "$body" 2>/dev/null
}
load_helpers

# Бронебойный экстрактор тела метода: state machine по символам,
# не зависит от кавычек/heredoc/арифметики внутри тела.
extract_method_body() {
    local func_name="$1"
    local line="" tline="" nxt="" q="" rest="" k=""
    local mode="none" delim="" delim_tabs=0
    local depth=0 arith=0
    local c="" prev=""
    local i=0 j=0 ln=0
    local collecting=0 buf="" candidate=""

    while IFS= read -r line || [ -n "$line" ]; do
        ln=$((ln + 1))

        if [ "$collecting" -eq 0 ] && [ "$mode" = "none" ] && [ "$arith" -eq 0 ] \
            && [[ "$line" =~ ^"$func_name"\(\) ]]; then
            collecting=1
            buf=""
            depth=0
        fi

        if [ "$mode" = "hd" ]; then
            tline="$line"
            [ "$delim_tabs" -eq 1 ] && tline="${tline#"${tline%%[!	]*}"}"
            [ "$tline" = "$delim" ] && mode="none"
        else
            prev=""
            i=0
            while [ "$i" -lt "${#line}" ]; do
                c="${line:$i:1}"
                if [ "$mode" = "none" ]; then
                    if [ "$arith" -gt 0 ]; then
                        case "$c" in
                            '(') [ "${line:$((i+1)):1}" = "(" ] && { arith=$((arith + 1)); i=$((i + 1)); } ;;
                            ')') [ "${line:$((i+1)):1}" = ")" ] && { arith=$((arith - 1)); i=$((i + 1)); } ;;
                        esac
                    else
                    case "$c" in
                        "'") [ "$prev" = '$' ] && mode="aq" || mode="sq" ;;
                        '"') mode="dq" ;;
                        '`') mode="bt" ;;
                        '#')
                            if [ -z "$prev" ] || [ "$prev" = " " ] || [ "$prev" = $'\t' ] \
                               || [ "$prev" = ";" ] || [ "$prev" = "(" ] || [ "$prev" = "|" ] \
                               || [ "$prev" = "&" ]; then
                                i="${#line}"; continue
                            fi
                            ;;
                        '{') depth=$((depth + 1)) ;;
                        '}') depth=$((depth - 1)) ;;
                        '<')
                            if [ "${line:$((i+1)):1}" = "<" ] && [ "${line:$((i+2)):1}" != "<" ]; then
                                nxt="${line:$((i+2)):1}"
                                case "$nxt" in
                                    -|"'"|'"'|'\'|[A-Za-z_])
                                        j=$((i + 2))
                                        [ "${line:$j:1}" = "-" ] && { delim_tabs=1; j=$((j + 1)); }
                                        nxt="${line:$j:1}"
                                        if [ "$nxt" = "'" ] || [ "$nxt" = '"' ]; then
                                            q="$nxt"
                                            rest="${line:$((j + 1))}"
                                            delim="${rest%%"$q"*}"
                                        else
                                            [ "$nxt" = '\' ] && j=$((j + 1))
                                            rest="${line:$j}"
                                            delim=""
                                            while [ ${#rest} -gt 0 ]; do
                                                k="${rest:0:1}"
                                                case "$k" in
                                                    ' '|$'\t'|';'|'|'|'('|')'|'<'|'>'|'&') break ;;
                                                    *) delim+="$k"; rest="${rest:1}" ;;
                                                esac
                                            done
                                        fi
                                        mode="hd"
                                        i="${#line}"; continue
                                        ;;
                                esac
                            fi
                            ;;
                        '(')
                            if [ "${line:$((i+1)):1}" = "(" ]; then
                                arith=$((arith + 1)); i=$((i + 1))
                            fi
                            ;;
                        ')') ;;
                        '$')
                            if [ "${line:$((i+1)):1}" = "(" ] && [ "${line:$((i+2)):1}" = "(" ]; then
                                arith=$((arith + 1)); i=$((i + 2))
                            fi
                            ;;
                    esac
                    fi
                else
                    case "$mode" in
                        sq) [ "$c" = "'" ] && mode="none" ;;
                        aq)
                            if [ "$c" = '\' ]; then i=$((i + 1))
                            elif [ "$c" = "'" ]; then mode="none"; fi
                            ;;
                        dq)
                            if [ "$c" = '\' ]; then i=$((i + 1))
                            elif [ "$c" = '"' ]; then mode="none"; fi
                            ;;
                        bt)
                            if [ "$c" = '\' ]; then i=$((i + 1))
                            elif [ "$c" = '`' ]; then mode="none"; fi
                            ;;
                    esac
                fi
                prev="$c"
                i=$((i + 1))
            done
        fi

        if [ "$collecting" -eq 1 ]; then
            buf+="$line"$'\n'
            if [ "$mode" = "none" ] && [ "$arith" -eq 0 ] && [ "$depth" -le 0 ]; then
                candidate="$buf"
                if printf '%s' "$candidate" | bash -n - 2>/dev/null; then
                    printf '%s' "$candidate"; return 0
                fi
                collecting=2
            fi
        elif [ "$collecting" -eq 2 ]; then
            buf+="$line"$'\n'
            if printf '%s' "$buf" | bash -n - 2>/dev/null; then
                printf '%s' "$buf"; return 0
            fi
        fi
    done < "$CONF_FILE"

    [ "$collecting" -ge 1 ] && printf '%s' "$buf"
    return 0
}

# Извлечение и проверка тела метода, загрузка только по запросу
load_method() {
    local method_name="$1"
    local func_name="me_method_${method_name}"

    declare -f "$func_name" >/dev/null 2>&1 && return 0

    local body
    body=$(load_method_source "$func_name")

    [ -z "$body" ] && return 1

    local tmpfile
    tmpfile=$(mktemp -p /dev/shm "me_check_XXXXXX.sh" 2>/dev/null)
    [ -z "$tmpfile" ] && { echo "[me] Ошибка: не удалось создать временный файл" >&2; return 1; }

    trap 'rm -f "$tmpfile"' RETURN
    echo "$body" > "$tmpfile"

    local err
    if ! err=$(bash -n "$tmpfile" 2>&1); then
        echo "[me] Ошибка синтаксиса в методе '$method_name':" >&2
        echo "$err" | sed 's/^/  /' >&2
        return 1
    fi

    eval "$body" || { echo "[me] Ошибка загрузки метода '$method_name'" >&2; return 1; }
    return 0
}

# --- Кэш методов ($HOME/.cache/me/methods) — персистентный, ленивое заполнение ---
# Переживает перезагрузку: после ребута tёплый кэш работает сразу.
# При изменении me.conf кэш сносится целиком, но пересобирается только по мере
# обращения к методам (инкрементно), без полной паузы.

# Кэш валиден, если md5(me.conf) совпадает с .hash внутри каталога методов
method_cache_ok() {
    [ -f "$CACHE_DIR/methods/.hash" ] || return 1
    local cur
    cur=$(md5sum "$CONF_FILE" | cut -d' ' -f1 2>/dev/null)
    [ -n "$cur" ] && [ "$cur" = "$(cat "$CACHE_DIR/methods/.hash" 2>/dev/null)" ]
}

# Атомарная запись файла кэша: tmp + mv (защита от гонок параллельных вызовов me)
cache_write() {
    local f="$1" content="$2" tmpf=""
    mkdir -p "$(dirname "$f")" || return 1
    tmpf="$f.tmp.$$"
    printf '%s' "$content" > "$tmpf" || { rm -f "$tmpf"; return 1; }
    mv "$tmpf" "$f"
}

# Инкрементная сборка: извлекает и кэширует только один запрошенный метод
lazy_method_cache() {
    local func_name="$1"
    local f="$CACHE_DIR/methods/$func_name.sh"
    local body
    body=$(extract_method_body "$func_name")
    [ -n "$body" ] || return 1
    cache_write "$f" "$body" || return 1
    cache_write "$CACHE_DIR/methods/.hash" "$(md5sum "$CONF_FILE" | cut -d' ' -f1)" || return 1
    printf '%s' "$body"
}

# Полная пересборка кэша: сборка в tmp, затем mv (либо всё, либо ничего)
build_method_cache() {
    method_cache_ok && return 0
    local tmpdir="$CACHE_DIR/methods.tmp.$$"
    rm -rf "$tmpdir"
    mkdir -p "$tmpdir" || return 1
    local name="" func_name="" body="" ok=1
    while read -r line; do
        case "$line" in
            "#@method:"*)
                name=${line#*:}
                name=${name#"${name%%[![:space:]]*}"}
                [ -z "$name" ] && continue
                func_name="me_method_$name"
                body=$(extract_method_body "$func_name")
                if [ -n "$body" ]; then
                    printf '%s' "$body" > "$tmpdir/$func_name.sh" || ok=0
                fi
                ;;
        esac
    done < "$CONF_FILE"
    if [ "$ok" -eq 1 ]; then
        md5sum "$CONF_FILE" | cut -d' ' -f1 > "$tmpdir/.hash"
        rm -rf "$CACHE_DIR/methods"
        mv "$tmpdir" "$CACHE_DIR/methods"
    else
        rm -rf "$tmpdir"
    fi
    [ "$ok" -eq 1 ]
}

# Источник тела метода: файл из кэша или инкрементная сборка
load_method_source() {
    local func_name="$1"
    local f="$CACHE_DIR/methods/$func_name.sh"
    if method_cache_ok && [ -f "$f" ]; then
        cat "$f"
        return 0
    fi
    # Кэш устарел (md5(me.conf) изменился) — снести целиком, чтобы не отдать старые тела
    if [ -d "$CACHE_DIR/methods" ] && ! method_cache_ok; then
        rm -rf "$CACHE_DIR/methods"
    fi
    lazy_method_cache "$func_name"
}

# Функция сборки полного текстового кэша (только для вызова общей справки)
compile_full_cache() {
    mkdir -p "$CACHE_DIR"
    local current_method="" current_desc="" current_ex=""
    {
        echo "Центральный динамический пульт 'me'."
        echo "Использование: me <имя_метода> [аргументы]"
        echo "               me -m <имя_метода> (справка о методе)"
        echo
        echo "Зарегистрированные методы в me.conf:"
        echo "----------------------------------------------------------------------"
        while read -r line; do
            case "$line" in
                "#@method:"*) current_method=$(echo "$line" | cut -d':' -f2- | xargs) ;;
                "#@description:"*) current_desc=$(echo "$line" | cut -d':' -f2- | xargs) ;;
                "#@example:"*)
                    current_ex=$(echo "$line" | cut -d':' -f2- | xargs)
                    if [ -n "$current_method" ]; then
                        printf "  \033[1;32m%-15s\033[0m %s\n" "$current_method" "$current_desc"
                        printf "                  \033[0;36mПример:\033[0m %s\n\n" "$current_ex"
                    fi
                    current_method="" current_desc="" current_ex=""
                    ;;
            esac
        done < "$CONF_FILE"
    } > "$CACHE_FILE"
    md5sum "$CONF_FILE" | cut -d' ' -f1 > "$HASH_FILE" 2>/dev/null
}

# Вывод точечной справки по конкретному методу
show_single_help() {
    local target="$1"
    if [ ! -s "$CONF_FILE" ]; then return; fi

    echo "Справка по методу '$target':"
    echo "----------------------------------------------------------------------"
    awk -v t="$target" '
        $1 == "#@method:" && $2 == t { flag=1; m=$2; next }
        flag && $1 == "#@description:" { sub("#@description:[ \t]*", ""); d=$0; next }
        flag && $1 == "#@example:" {
            sub("#@example:[ \t]*", ""); e=$0;
            printf "  \033[1;32m%-15s\033[0m %s\n", m, d
            printf "                  \033[0;36mПример:\033[0m %s\n\n", e
            flag=0; exit
        }
    ' "$CONF_FILE"
}

# Интерактивный выбор команды (built-in для "me int")
interactive_selector() {
    local list chosen cmd edited_cmd

    # Сбор команд и вариантов из me.conf в формат "команда|категория|описание|пример"
    list=$(awk '
        BEGIN { m = ""; d = ""; e = ""; cat = ""; v = 0; vf = 0 }
        /^#@method:[ \t]*/ {
            if (m != "" && !vf) print m "\t" cat "\t" d "\t" e
            m = "me " $2; d = ""; e = ""; cat = ""; v = 0; vf = 0; next
        }
        /^#@description:[ \t]*/ {
            sub(/^#@description:[ \t]*/, ""); d = $0
            cat = ""
            if (match(d, /^\[cat: [^]]*\] */)) {
                cat = substr(d, RSTART, RLENGTH)
                gsub(/[ \t]+$/, "", cat)
                d = substr(d, RSTART + RLENGTH)
            }
            next
        }
        /^#@example:[ \t]*/ {
            sub(/^#@example:[ \t]*/, ""); e = $0; next
        }
        /^#@variants:/ { v = 1; next }
        /^#   me / {
            if (v) {
                sub(/^#   /, "")
                if (match($0, /[ \t]+# /)) {
                    vc = substr($0, 1, RSTART - 1)
                    gsub(/[ \t]+$/, "", vc)
                    vd = substr($0, RSTART + RLENGTH)
                } else {
                    vc = $0; vd = d
                }
                print vc "\t" cat "\t" vd "\t" e
                vf = 1
            }
            next
        }
        /^me_method_.*\(\)/ {
            if (!vf && m != "") print m "\t" cat "\t" d "\t" e
            m = ""; vf = 0; next
        }
        END {
            if (m != "" && !vf) print m "\t" cat "\t" d "\t" e
        }
    ' "$CONF_FILE") || true

    [ -z "$list" ] && { echo "[me] Нет команд в $CONF_FILE" >&2; return 1; }

    if command -v fzf &>/dev/null; then
        chosen=$(echo "$list" | fzf \
            --reverse \
            --delimiter=$'\t' \
            --with-nth=1,2 \
            --preview='printf "\033[1;32m  %s\033[0m\n  \033[0;36mОписание:\033[0m %s\n  \033[0;36mПример:\033[0m %s\n" {2} {3} {4}' \
            --preview-window='right:60%:wrap' \
            --bind='f5:execute($HOME/.local/bin/me/me_lib/int_help.sh {1})' \
            --prompt='me > ' \
            2>/dev/null) || return 0
        [ -z "$chosen" ] && return 0
        chosen="${chosen%%$'\t'*}"
    else
        echo "[me] fzf не установлен. Установи: sudo apt install fzf" >&2
        echo "[me] Работаю в текстовом режиме..." >&2
        echo >&2
        local i=0
        local -a cmds=()
        while IFS=$'\t' read -r c cat d e; do
            i=$((i + 1))
            cmds+=("$c")
            printf "  %2d. %s  %s  # %s\n" "$i" "$c" "$cat" "$d" >&2
        done <<< "$list"
        echo >&2
        local choice
        read -p "Выберите номер: " choice
        [ -z "$choice" ] && return 0
        choice=$((choice - 1))
        [ "$choice" -lt 0 ] || [ "$choice" -ge "$i" ] && { echo "[me] Неверный номер" >&2; return 1; }
        chosen="${cmds[$choice]}"
    fi

    printf '%s\n' "$chosen"  # output to stdout (caller decides execution)
}

# --- ИНТЕРПРЕТАТОР КОМАНД ---

# 1. Абсолютно пустой вызов — выводим полный кэшированный список
if [ -z "$1" ]; then
    current_hash=$(md5sum "$CONF_FILE" | cut -d' ' -f1 2>/dev/null)
    cached_hash=$(cat "$HASH_FILE" 2>/dev/null)
    if [ "$current_hash" != "$cached_hash" ] || [ ! -f "$CACHE_FILE" ]; then
        compile_full_cache
    fi
    cat "$CACHE_FILE" 2>/dev/null
    exit 0
fi

# 2. Флаг -m — вывод справки
if [ "$1" = "-m" ]; then
    shift
    if [ -z "$1" ]; then
        current_hash=$(md5sum "$CONF_FILE" | cut -d' ' -f1 2>/dev/null)
        cached_hash=$(cat "$HASH_FILE" 2>/dev/null)
        if [ "$current_hash" != "$cached_hash" ] || [ ! -f "$CACHE_FILE" ]; then
            compile_full_cache
        fi
        cat "$CACHE_FILE" 2>/dev/null
    else
        show_single_help "$1"
    fi
    exit 0
fi

# 3. Интерактивный режим (вывод команды на stdout)
if [ "$1" = "int" ]; then
    interactive_selector
    exit $?
fi

# 3.1 Принудительная пересборка кэша методов
if [ "$1" = "cache-rebuild" ]; then
    rm -rf "$CACHE_DIR/methods"
    if build_method_cache; then
        echo "[me] Кэш методов пересобран: $CACHE_DIR/methods"
    else
        echo "[me] Ошибка пересборки кэша методов" >&2
        exit 1
    fi
    exit 0
fi

method_name="$1"
shift

# 4. Ленивая загрузка и вызов метода
if load_method "$method_name"; then
    show_logo
    "me_method_${method_name}" "$@"
else
    echo "[me] Ошибка: Метод '$method_name' не найден или содержит ошибки в me.conf." >&2
    echo "Запусти 'me' без аргументов для просмотра доступных команд." >&2
    exit 1
fi
