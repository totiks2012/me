#!/usr/bin/env bash
# me – универсальный инструмент оперативного управления системой
# Отказоустойчивый движок с ленивой загрузкой методов

CONF_DIR="$HOME/.config/me"
CONF_FILE="$CONF_DIR/me.conf"

ME_BASE="$HOME/.local/bin/me"

CACHE_DIR="$HOME/.cache/me"
CACHE_FILE="$CACHE_DIR/me.cache"
HASH_FILE="$CACHE_DIR/me.hash"

ME_LOGO_FILE="$CONF_DIR/.logo"
ME_LOGO_ENABLED=0
[ -f "$ME_LOGO_FILE" ] && [ "$(cat "$ME_LOGO_FILE")" = "1" ] && ME_LOGO_ENABLED=1

show_logo() {
    [ "$ME_LOGO_ENABLED" -eq 0 ] && return
    printf '\033[1;32m\\me/\033[0m\n'
}

if [ ! -f "$CONF_FILE" ]; then
    mkdir -p "$CONF_DIR"
    touch "$CONF_FILE"
    echo "[me] Создан пустой конфиг: $CONF_FILE." >&2
fi

# Разрешение пути к скрипту метода из #@script: в me.conf (архитектура без eval).
# me.conf — контракт: #@method + meta-теги + #@script: <путь>. Тела функций НЕ хранятся.
script_dir() {
    local name="$1"
    local dpath
    dpath=$(awk -v t="$name" '
        /^#@method:[ \t]*/ { m = $2 }
        m == t && /^#@script:[ \t]*/ {
            sub(/^#@script:[ \t]*/, "")
            print
            exit
        }
        m != "" && m != t && /^#@script:/ { m = "" }
    ' "$CONF_FILE")
    case "$dpath" in
        "")  printf '' ;;
        /*)  printf '%s\n' "$dpath" ;;
        *)   printf '%s\n' "$ME_BASE/$dpath" ;;
    esac
}

# Функция сборки полного текстового кэша (только для вызова общей справки)
compile_full_cache() {
    mkdir -p "$CACHE_DIR"
    local current_method="" current_desc="" current_ex=""
    {
        echo "Центральный динамический пульт 'me'."
        echo "Использование: me <имя_метода> [аргументы]"
        echo "               me -m <имя_метода> (справка о методе)"
        echo
        echo "Зарегистрированные методы в me.conf:"
        echo "----------------------------------------------------------------------"
        while read -r line; do
            case "$line" in
                "#@method:"*) current_method=$(echo "$line" | cut -d':' -f2- | xargs) ;;
                "#@description:"*) current_desc=$(echo "$line" | cut -d':' -f2- | xargs) ;;
                "#@example:"*)
                    current_ex=$(echo "$line" | cut -d':' -f2- | xargs)
                    if [ -n "$current_method" ]; then
                        printf "  \033[1;32m%-15s\033[0m %s\n" "$current_method" "$current_desc"
                        printf "                  \033[0;36mПример:\033[0m %s\n\n" "$current_ex"
                    fi
                    current_method="" current_desc="" current_ex=""
                    ;;
            esac
        done < "$CONF_FILE"
    } > "$CACHE_FILE"
    md5sum "$CONF_FILE" | cut -d' ' -f1 > "$HASH_FILE" 2>/dev/null
}

# Вывод точечной справки по конкретному методу
show_single_help() {
    local target="$1"
    if [ ! -s "$CONF_FILE" ]; then return; fi

    echo "Справка по методу '$target':"
    echo "----------------------------------------------------------------------"
    awk -v t="$target" '
        $1 == "#@method:" && $2 == t { flag=1; m=$2; next }
        flag && $1 == "#@description:" { sub("#@description:[ \t]*", ""); d=$0; next }
        flag && $1 == "#@example:" {
            sub("#@example:[ \t]*", ""); e=$0;
            printf "  \033[1;32m%-15s\033[0m %s\n", m, d
            printf "                  \033[0;36mПример:\033[0m %s\n\n", e
            flag=0; exit
        }
    ' "$CONF_FILE"
}

# Интерактивный выбор команды (built-in для "me int")
interactive_selector() {
    local list chosen cmd edited_cmd

    # Сбор команд и вариантов из me.conf в формат "команда|категория|описание|пример"
    list=$(awk '
        BEGIN { m = ""; d = ""; e = ""; cat = ""; v = 0; vf = 0 }
        /^#@method:[ \t]*/ {
            if (m != "" && !vf) print m "\t" cat "\t" d "\t" e
            m = "me " $2; d = ""; e = ""; cat = ""; v = 0; vf = 0; next
        }
        /^#@description:[ \t]*/ {
            sub(/^#@description:[ \t]*/, ""); d = $0
            cat = ""
            if (match(d, /^\[cat: [^]]*\] */)) {
                cat = substr(d, RSTART, RLENGTH)
                gsub(/[ \t]+$/, "", cat)
                d = substr(d, RSTART + RLENGTH)
            }
            next
        }
        /^#@example:[ \t]*/ {
            sub(/^#@example:[ \t]*/, ""); e = $0; next
        }
        /^#@variants:/ { v = 1; next }
        /^#   me / {
            if (v) {
                sub(/^#   /, "")
                if (match($0, /[ \t]+# /)) {
                    vc = substr($0, 1, RSTART - 1)
                    gsub(/[ \t]+$/, "", vc)
                    vd = substr($0, RSTART + RLENGTH)
                } else {
                    vc = $0; vd = d
                }
                print vc "\t" cat "\t" vd "\t" e
                vf = 1
            }
            next
        }
        /^me_method_.*\(\)/ {
            if (!vf && m != "") print m "\t" cat "\t" d "\t" e
            m = ""; vf = 0; next
        }
        END {
            if (m != "" && !vf) print m "\t" cat "\t" d "\t" e
        }
    ' "$CONF_FILE") || true

    [ -z "$list" ] && { echo "[me] Нет команд в $CONF_FILE" >&2; return 1; }

    if command -v fzf &>/dev/null; then
        local fzf_args fzf_rc fzf_out fzf_err
        fzf_args=(fzf --reverse \
            --delimiter=$'\t' \
            --with-nth=1,2 \
            --preview='printf "\033[1;32m  %s\033[0m\n  \033[0;36mОписание:\033[0m %s\n  \033[0;36mПример:\033[0m %s\n" {2} {3} {4}' \
            --preview-window='right:60%:wrap' \
            --bind='f5:execute($HOME/.local/bin/me/me_lib/int_help.sh {1})' \
            --prompt='me > ')
        fzf_out=$(mktemp "${TMPDIR:-/tmp}/me-fzf-out.XXXXXX" 2>/dev/null) || fzf_out=""
        fzf_err=$(mktemp "${TMPDIR:-/tmp}/me-fzf-err.XXXXXX" 2>/dev/null) || fzf_err=""
        chosen=""
        if [ -z "$fzf_out" ] || [ -z "$fzf_err" ]; then
            echo "[me] fzf: не удалось создать временный файл." >&2
            rm -f "$fzf_out" "$fzf_err"
            return 1
        fi
        # FZF_DEFAULT_OPTS= — сброс глобальных опций (главная причина «UI уходит в stderr»
        # при --height). stderr fzf (там же рисуется UI у нестандартных сборок) → на /dev/tty
        # плюс дубль в файл для fallback-парсинга выбора. Канонический fzf рисует в /dev/tty,
        # stderr у него пуст — на терминал ничего лишнего не попадёт.
        if [ -t 0 ] || [ -t 1 ]; then
            echo "$list" | FZF_DEFAULT_OPTS= "${fzf_args[@]}" \
                >"$fzf_out" 2> >(tee "$fzf_err" >/dev/tty)
            fzf_rc=$?
            wait "$!" 2>/dev/null || true
        else
            echo "$list" | FZF_DEFAULT_OPTS= "${fzf_args[@]}" >"$fzf_out" 2>"$fzf_err"
            fzf_rc=$?
        fi
        if [ "$fzf_rc" -eq 0 ] && [ -s "$fzf_out" ]; then
            chosen=$(head -1 "$fzf_out")
        elif [ "$fzf_rc" -eq 0 ] && [ -s "$fzf_err" ]; then
            # Нестандартные сборки могут печатать выбор в stderr — забираем без ANSI/CR.
            chosen=$(sed -e $'s/\e\[[0-9;?]*[a-zA-Z]//g' -e $'s/\e\][^\a]*\a//g' -e 's/\r//g' "$fzf_err" \
                | grep -v '^[[:space:]]*$' | tail -1)
        fi
        rm -f "$fzf_out" "$fzf_err"
        [ -z "$chosen" ] && return 0
        chosen="${chosen%%$'\t'*}"
    else
        echo "[me] fzf не установлен. Установи: sudo apt install fzf" >&2
        echo "[me] Работаю в текстовом режиме..." >&2
        echo >&2
        local i=0
        local -a cmds=()
        while IFS=$'\t' read -r c cat d e; do
            i=$((i + 1))
            cmds+=("$c")
            printf "  %2d. %s  %s  # %s\n" "$i" "$c" "$cat" "$d" >&2
        done <<< "$list"
        echo >&2
        local choice
        read -p "Выберите номер: " choice
        [ -z "$choice" ] && return 0
        choice=$((choice - 1))
        [ "$choice" -lt 0 ] || [ "$choice" -ge "$i" ] && { echo "[me] Неверный номер" >&2; return 1; }
        chosen="${cmds[$choice]}"
    fi

    printf '%s\n' "$chosen"  # output to stdout (caller decides execution)
}

# --- ИНТЕРПРЕТАТОР КОМАНД ---

# 1. Абсолютно пустой вызов — выводим полный кэшированный список
if [ -z "$1" ]; then
    current_hash=$(md5sum "$CONF_FILE" | cut -d' ' -f1 2>/dev/null)
    cached_hash=$(cat "$HASH_FILE" 2>/dev/null)
    if [ "$current_hash" != "$cached_hash" ] || [ ! -f "$CACHE_FILE" ]; then
        compile_full_cache
    fi
    cat "$CACHE_FILE" 2>/dev/null
    exit 0
fi

# 2. Флаг -m — вывод справки
if [ "$1" = "-m" ]; then
    shift
    if [ -z "$1" ]; then
        current_hash=$(md5sum "$CONF_FILE" | cut -d' ' -f1 2>/dev/null)
        cached_hash=$(cat "$HASH_FILE" 2>/dev/null)
        if [ "$current_hash" != "$cached_hash" ] || [ ! -f "$CACHE_FILE" ]; then
            compile_full_cache
        fi
        cat "$CACHE_FILE" 2>/dev/null
    else
        show_single_help "$1"
    fi
    exit 0
fi

# 3. Интерактивный режим (вывод команды на stdout)
if [ "$1" = "int" ]; then
    interactive_selector
    exit $?
fi

# 3.1 Совместимая заглушка: кэша тел нет (архитектура без eval, чтение #@script: напрямую)
if [ "$1" = "cache-rebuild" ]; then
    rm -rf "$CACHE_DIR/methods" "$CACHE_FILE" "$HASH_FILE" 2>/dev/null
    echo "[me] Кэш методов не используется — методы читаются из me.conf напрямую."
    exit 0
fi

method_name="$1"
shift

# 4. Ленивый запуск метода: резолв #@script: → проверка -x → субпроцесс (без eval)
sdir=$(script_dir "$method_name")
if [ -z "$sdir" ]; then
    echo "[me] Ошибка: Метод '$method_name' не найден в me.conf (нет #@script:)." >&2
    echo "Запусти 'me' без аргументов для просмотра доступных команд." >&2
    exit 1
fi
if [ ! -f "$sdir" ] || [ -d "$sdir" ] || [ ! -x "$sdir" ]; then
    echo "[me] Ошибка: скрипт '$sdir' метода '$method_name' не найден или не исполняемый." >&2
    exit 1
fi
show_logo
"$sdir" "$@"
exit $?
